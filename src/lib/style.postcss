/* Fonts */
@font-face {
	font-family: 'GT Walsheim';
	src: url('$lib/fonts/GT-Walsheim/GT-Walsheim-Bold-Trial.woff2') format('woff2');
}

@font-face {
	font-family: 'GT America';
	src: url('$lib/fonts/GT-America/GT-America-Standard-Regular-Trial.woff2') format('woff2');
}

/* CSS Reset */
*, *::before, *::after {
	box-sizing: border-box;
	margin: 0;
	padding: 0;
	border: none;
	outline: none;
	font: inherit;
	color: inherit;
	background: none;
	text-decoration: none;
	min-width: 0;
	line-height: 1.5em;
	letter-spacing: inherit;
	list-style-type: none;
}

/* Variables */
:root {
	--layer-0: #16110e;
	--layer-1: #27211E;
	--layer-2: #514A47;

	--text: #CAC0BB;

	--border: #33302b;

	--orange: 255, 178, 114;
	--blue: 105, 241, 235;
	--red: 210, 132, 156;
	--green: 140, 170, 102;

	--stone-player-1: var(--blue);
	--stone-player-2: var(--orange);

	--snappy: 0.1s cubic-bezier(0.25, 1, 0.5, 1);

	font-family: 'GT America', sans-serif;
	font-size: 1.5rem;

	color-scheme: dark;
	accent-color: rgb(var(--orange));
}

:focus-visible,
input[type="checkbox"]:focus-visible + label {
	outline: 2px solid rgb(var(--orange));
	outline-offset: 2px;
}

html, body {
	height: 100%;
}

body {
	padding: 2rem;
	background: var(--layer-0);
	display: flex;
	gap: 1rem;
	color: var(--text);
	justify-content: center;
}

section {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}

.container {
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

.grow {
	flex: 1 0 min-content;
}

h2 {
	font-family: 'GT Walsheim', sans-serif;
	font-size: 1.5rem;
}

small {
	font-size: 0.7rem;
}

ul { list-style: none }

label, button {
	cursor: pointer;
}

input[type="text"] {
	background: var(--layer-1);
	border-radius: 1rem;
	padding: 1rem;
}

.button {
	position: relative;
	display: flex;
	gap: 0.5rem;
	justify-content: center;
	align-items: center;
	padding: 0.5rem;
	min-height: 3rem;
	border-radius: 1rem;
	font-family: 'GT Walsheim', sans-serif;

	svg {
		font-size: 2rem;
		flex: 0 0 auto;
	}

	&:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
}

.button-bg { background: var(--layer-1); }
.button-bg-primary {
	background: rgb(var(--orange));
	color: var(--layer-0);
}

.button-actions {
	display: flex;
	gap: 0.5rem;

	& > .button {
		flex: 1;
	}
}

@media (max-width: 30rem) {
	.button-actions {
		flex-direction: column;
	}
}


.tabs {
	display: flex;
	gap: 0.5rem;

	& > .button {
		flex: 1;
	}
}


.link {
	color: rgb(var(--orange));
	text-decoration: underline;
}


/* https://aleclownes.com/2017/02/01/crt-display.html */
body::before {
	content: " ";
	position: fixed;
	inset: 0;
	background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgb(255 0 0 / 14%), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
	z-index: 999999;
	background-size: 100% 2px, 3px 100%;
	pointer-events: none;
}
body {
	text-shadow: 0 0 1.5px currentColor;
}

.card {
	background: var(--layer-1);
	padding: 0.5rem;
	border-radius: 0.5rem;

	&.bordered {
		border: 1px solid var(--border);
	}

	&.exception {
		--rgb: var(--orange);
		background: rgba(var(--rgb), 0.1);
		color: rgb(var(--rgb));
		border: 1px solid rgba(var(--rgb), 0.2);
	}
}

@media (max-width: 1000px) {
	body {
		padding: 2rem 0.5rem;
	}
}

.hide {
	display: none !important;
}
